# AI Provider API Keys
# Get your Anthropic API key from: https://console.anthropic.com/
PENPOT_MCP_ANTHROPIC_API_KEY=sk-ant-...

# Get your OpenAI API key from: https://platform.openai.com/
PENPOT_MCP_OPENAI_API_KEY=sk-...

# Get your DeepSeek API key from: https://platform.deepseek.com/
PENPOT_MCP_DEEPSEEK_API_KEY=sk-...

# Optional: Custom API base URLs (for self-hosted or proxy setups)
# PENPOT_MCP_ANTHROPIC_BASE_URL=https://api.anthropic.com
# PENPOT_MCP_OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration
PENPOT_MCP_SERVER_HOST=0.0.0.0
PENPOT_MCP_SERVER_PORT=4401
PENPOT_MCP_WEBSOCKET_PORT=4402
PENPOT_MCP_REPL_PORT=4403

# Logging
PENPOT_MCP_LOG_LEVEL=info
PENPOT_MCP_LOG_DIR=logs
